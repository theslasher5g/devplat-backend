# --- Core ---------------------------------------------------------------
# Inside the compose network Postgres is reachable as "postgres:5432"
DATABASE_URL=postgres://devplat:CHANGE_ME@postgres:5432/devplat
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME
PORT=3000
HOST=0.0.0.0

# Public URL of the frontend (CORS origin, links in emails)
FRONTEND_URL=https://devplat.ch
# Public URL of this API (Stripe return URLs are derived from FRONTEND_URL,
# webhook endpoint is API_URL/webhooks/stripe)
API_URL=https://api.devplat.ch

# Cookie domain so devplat.ch and api.devplat.ch share the session cookie.
# Leave empty for local development (host-only cookie on localhost).
COOKIE_DOMAIN=.devplat.ch

# --- Resend ---------------------------------------------------------------
RESEND_API_KEY=re_CHANGE_ME
# EMAIL_FROM's domain must be added AND verified (DNS/SPF/DKIM) under this
# API key's Resend account, or every send fails with "not authorized to
# send emails from <domain>". Until devplat.ch is verified there, use
# Resend's built-in onboarding sender instead: onboarding@resend.dev
EMAIL_FROM=devplat <noreply@devplat.ch>
# Inbox that receives "Book a call" / contact-form notifications.
CONTACT_EMAIL=hello@devplat.ch
# Ops alerting: where infrastructure alerts (e.g. a host going offline) are
# emailed. Defaults to CONTACT_EMAIL when unset.
OPS_ALERT_EMAIL=ops@devplat.ch
# Optional Slack incoming-webhook URL; when set, host-offline alerts are also
# posted there. Leave empty to disable the Slack channel.
SLACK_ALERT_WEBHOOK_URL=

# --- Outgoing webhooks ----------------------------------------------------
# LOCAL DEVELOPMENT ONLY — leave this unset in production.
#
# Customer-defined webhook URLs are fetched by this process, which sits on the
# WireGuard mesh and can reach every agent's unauthenticated Docker API. Any URL
# resolving to a private, loopback or link-local address is therefore refused,
# and the check runs inside the socket's DNS lookup so it cannot be defeated by
# DNS rebinding. Setting this to true removes that protection so deliveries can
# be tested against a local receiver. The server logs a warning on startup when
# it is on.
WEBHOOK_ALLOW_PRIVATE_TARGETS=

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# Created by `npm run stripe:setup` (prints these IDs)
STRIPE_PRICE_SOLO_MONTHLY=price_...
STRIPE_PRICE_SOLO_YEARLY=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_YEARLY=price_...
STRIPE_PRICE_SCALE_MONTHLY=price_...
STRIPE_PRICE_SCALE_YEARLY=price_...

# --- Seasonal promo (optional) ---------------------------------------------
# Run a time-boxed discount (e.g. "15% off in August"). First create a Coupon
# in the Stripe dashboard (e.g. 15% off, duration once/repeating), then set its
# id here. While active it is auto-applied at checkout (no code to type) and
# advertised by GET /promo. Leave PROMO_COUPON_ID empty to disable — checkout
# then accepts a manually-entered promotion code instead.
PROMO_COUPON_ID=
PROMO_LABEL=15% off every plan through August
PROMO_CODE=AUGUST15
PROMO_ENDS_AT=2026-09-01T00:00:00Z

# --- Scheduler / Firecracker data plane ------------------------------------
# Per-VM sizing is NOT configured here anymore — it's the requesting team's
# plan cap (plans.vcpu_per_environment / ram_gb_per_environment), looked up per
# request and passed to the agent as that VM's hard limit. Edit the `plans`
# table (migrations/003_plans.sql) to change tier caps.
# A host is marked offline if neither its heartbeat nor a scheduler-initiated
# health poll succeeds within this many seconds.
AGENT_HEARTBEAT_TIMEOUT_SECONDS=90
# How often the queue worker retries queued environment requests and the
# health poller checks all agents.
SCHEDULER_POLL_INTERVAL_MS=5000
# Hosts themselves (agent_endpoint, agent_token, wireguard_ip, capacity) are
# registered at runtime via POST /admin/hosts, not env vars — see
# devplat-agent's README for the registration walkthrough.
